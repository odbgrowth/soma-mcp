# SOMA MCP configuration. Copy to .env and fill in locally.
# Never place real credentials or production values in this tracked template.
# Without the AUTH0_* block the server runs UNAUTHENTICATED on 127.0.0.1
# (local use only).

# --- OAuth 2.1 (Auth0): all five or none; a partial set refuses to start ---
AUTH0_CONFIG_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
BASE_URL=https://your-host.example/

# --- Access control (fail-closed) ---
# Comma-separated token subjects allowed to use this instance.
MCP_TOEGANG_SUBJECTS=
# Subset allowed to write (soma_write / soma_update / soma_delete).
MCP_SCHRIJF_SUBJECTS=
# Set to 1 to run deliberately without an allowlist (single-user). With Auth0
# this admits every account that can sign in to the Auth0 application.
MCP_SINGLE_USER=
# Calls per minute per subject (default 30; 0 disables).
MCP_RATE_LIMIT=30

# --- Persistent, encrypted token storage (optional; needs .[auth]) ---
# Both or neither, and only together with Auth0.
# Signing key: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Encryption key (Fernet): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_JWT_SIGNING_KEY=
MCP_STORAGE_ENCRYPTION_KEY=

# --- Bind address (defaults: 0.0.0.0:8000 with Auth0, 127.0.0.1:8000 without) ---
MCP_HOST=
MCP_PORT=

# --- Data path (token store in mcp_oauth/, audit log) ---
SOMA_DATA=.
